# Graph database (required). Started by: docker compose up -d falkordb
FALKORDB_HOST=localhost
FALKORDB_PORT=6379

# Required: Google AI Studio key that runs the Gemma models (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Required: live Google, Google Play and Reddit search (https://serpapi.com/manage-api-key)
SERPAPI_API_KEY=

# Recommended: TabPFN price prediction (https://ux.priorlabs.ai)
TABPFN_API_KEY=

# Optional: Listen button (https://elevenlabs.io/app/settings/api-keys)
ELEVENLABS_API_KEY=
# Optional: agent tracing (sentry.io, create a Python project)
SENTRY_DSN=
# Optional: any long random string; generated and saved in ideator/data/ if empty
SESSION_SECRET=
# Optional: GitHub sign-in; leave both empty for guest mode
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
